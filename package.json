{
    "name": "search-engine",
    "version": "1.0.0",
    "description": "Polyglot monorepo for a Distribution Search Engine",
    "private": true,
    "license": "UNLICENSED",
    "workspaces": [
        "apps/*",
        "services/*",
        "packages/*",
        "gen/ts"
    ],
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test  --workspaces --if-present",
        "lint": "npm run lint  --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "zod": "^4.6.7"
    }
}
