{
    "compilerOptions": {
        "target":                      "esnext",
        "module":                      "nodenext",
        "moduleResolution":            "nodenext",
        "lib":                         ["ESNext"],
        "strict":                      true,
        "exactOptionalPropertyTypes":  true,
        "noUncheckedIndexedAccess":    false,
        "declaration":                 true,
        "declarationMap":              true,
        "sourceMap":                   true,
        "esModuleInterop":             true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck":                true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": ["node"],
    }
}